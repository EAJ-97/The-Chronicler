# Leave JWT_SECRET empty so the entrypoint loads or creates /data/.jwt_secret
# on the data volume. Do not paste a placeholder here — a non-empty value
# overrides the volume secret (except values starting with replace-me, which
# the entrypoint ignores). Changing a real secret logs out all users.
JWT_SECRET=

# Optional: override emergency admin recovery token (Docker entrypoint auto-generates
# and saves to /data/.admin_recovery_token on the data volume if unset).
# ADMIN_RECOVERY_TOKEN=

# Session recaps use Anthropic (Claude). Configure the API key in Admin → AI (stored in the database).
# Optional model overrides (Claude API IDs):
# GLOSSARY_SCAN_MODEL=claude-haiku-5-5
# Summary (single-step) model:
# RECAP_MODEL=claude-sonnet-5-5
# Chronicle three-step pipeline (extract → write → verify):
# RECAP_EXTRACT_MODEL=claude-sonnet-5-5
# RECAP_WRITE_MODEL=claude-opus-5-5
# RECAP_VERIFY_MODEL=claude-sonnet-5-5
# Log each chronicle pipeline step's input/output (and include verify_report in API responses):
# RECAP_DEBUG=1
# Timezone for journal date headers in recap payloads (local calendar day):
# APP_TIMEZONE=America/Chicago
